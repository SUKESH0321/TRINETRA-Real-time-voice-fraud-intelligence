# Copy to .env (optional). Every setting has a safe default; nothing here is required.
# No API keys are needed anywhere in TRINETRA. Audio is never sent to an external service.

# Backend bind address / port (default 127.0.0.1:8000). Use 0.0.0.0 to reach the API from other devices.
TRINETRA_HOST=127.0.0.1
TRINETRA_PORT=8000

# Speech recognition for live audio: "auto" loads local faster-whisper (install with `npm run setup:asr`), "none" disables it.
TRINETRA_TRANSCRIBER=auto
TRINETRA_WHISPER_MODEL=base.en
# cpu (default) or cuda (needs the CUDA 12 cuBLAS libraries)
TRINETRA_WHISPER_DEVICE=cpu
# CPU threads for speech recognition (default: half the cores, at least 2)
# TRINETRA_WHISPER_THREADS=4
# Where the model is cached (default: the Hugging Face cache) and whether downloading is allowed.
# TRINETRA_MODEL_DIR=./models/whisper
# TRINETRA_OFFLINE=0

# Synthetic-speech detector (AASIST). "auto" uses it if `npm run setup:aasist` installed it, "off" disables it.
TRINETRA_AASIST=auto
# TRINETRA_AASIST_DIR=backend/models/aasist

# Experimental voice-manipulation check (pause-noise step). On by default, shown as experimental and never
# changes the risk level. Set to 0 to switch it off; see README "Limitations".
# TRINETRA_EXPERIMENTAL_SPLICE=0

# Where the Vite dev server proxies /api and /ws (only for `npm run dev`).
# TRINETRA_BACKEND=http://127.0.0.1:8000
